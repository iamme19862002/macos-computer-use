#!/bin/bash
#
# Git commit-msg hook for Conventional Commits validation
# Supports both English and Chinese commit messages
# Install: git config core.hooksPath .git-hooks
#

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip validation for merge commits, revert commits, or if message is empty
if echo "$COMMIT_MSG" | grep -qE "^Merge " || \
   echo "$COMMIT_MSG" | grep -qE "^Revert " || \
   [ -z "$COMMIT_MSG" ]; then
    exit 0
fi

# Extract the first line (subject) from the commit message
SUBJECT=$(echo "$COMMIT_MSG" | head -n 1)

# Conventional Commits regex pattern
# Supports both English and Chinese
# Format: type(scope): subject
# or: type: subject
# Supports BREAKING CHANGE marker
CC_PATTERN='^(feat|fix|docs|style|refactor|perf|test|chore|ci|revert|build)(\([a-zA-Z0-9_\-\u4e00-\u9fa5]+\))?!?: .{1,100}$'

# Types description for error messages
TYPES="feat, fix, docs, style, refactor, perf, test, chore, ci, revert, build"

echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Conventional Commits 验证${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Validate subject line format
if ! echo "$SUBJECT" | grep -qE "$CC_PATTERN"; then
    echo -e "${RED}✗ 提交信息验证失败！${NC}"
    echo ""
    echo -e "${YELLOW}你的提交信息：${NC}"
    echo "  $SUBJECT"
    echo ""
    echo -e "${YELLOW}期望格式：${NC}"
    echo "  <类型>(<范围>): <描述>"
    echo ""
    echo -e "${YELLOW}有效类型：${NC}"
    echo "  $TYPES"
    echo ""
    echo -e "${YELLOW}示例：${NC}"
    echo "  feat(api): 添加用户认证功能"
    echo "  fix(ui): 修复按钮对齐问题"
    echo "  docs(readme): 更新安装指南"
    echo "  chore(deps): 更新依赖版本"
    echo "  refactor(core): 简化错误处理"
    echo ""
    echo -e "${YELLOW}规则：${NC}"
    echo "  • 类型必须是上面列出的有效类型之一"
    echo "  • 范围是可选的（小写、字母数字、连字符、下划线）"
    echo "  • 描述不超过 100 个字符"
    echo "  • 使用祈使语气（例如"添加"而不是"添加了"）"
    echo "  • 描述末尾不要加句号"
    echo ""
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    exit 1
fi

# Extract type and scope for feedback
TYPE=$(echo "$SUBJECT" | sed -E 's/^(\w+)(\(.+\))?!?:.*/\1/')
SCOPE=$(echo "$SUBJECT" | sed -E 's/^\w+(\((.+)\))?!?:.*/\2/')
SUBJECT_TEXT=$(echo "$SUBJECT" | sed -E 's/^\w+(\(.+\))?!?: //')

echo -e "${GREEN}✓ 提交信息验证通过！${NC}"
echo ""
echo -e "${BLUE}解析结果：${NC}"
echo -e "  ${YELLOW}类型：${NC}  $TYPE"
if [ -n "$SCOPE" ] && [ "$SCOPE" != "$SUBJECT" ]; then
    echo -e "  ${YELLOW}范围：${NC}  $SCOPE"
fi
echo -e "  ${YELLOW}描述：${NC}  $SUBJECT_TEXT"
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

exit 0
