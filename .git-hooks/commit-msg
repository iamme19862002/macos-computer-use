#!/bin/bash
#
# Git commit-msg hook for Conventional Commits validation
# Install: git config core.hooksPath .git-hooks
#

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip validation for merge commits, revert commits, or if message is empty
if echo "$COMMIT_MSG" | grep -qE "^Merge " || \
   echo "$COMMIT_MSG" | grep -qE "^Revert " || \
   [ -z "$COMMIT_MSG" ]; then
    exit 0
fi

# Extract the first line (subject) from the commit message
SUBJECT=$(echo "$COMMIT_MSG" | head -n 1)

# Conventional Commits regex pattern
# Format: type(scope): subject
# or: type: subject
# Supports BREAKING CHANGE marker
CC_PATTERN='^(feat|fix|docs|style|refactor|perf|test|chore|ci|revert|build)(\([a-zA-Z0-9_-]+\))?!?: .{1,50}$'

# Types description for error messages
TYPES="feat, fix, docs, style, refactor, perf, test, chore, ci, revert, build"

echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Conventional Commits Validation${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Validate subject line format
if ! echo "$SUBJECT" | grep -qE "$CC_PATTERN"; then
    echo -e "${RED}✗ Commit message validation failed!${NC}"
    echo ""
    echo -e "${YELLOW}Your commit message:${NC}"
    echo "  $SUBJECT"
    echo ""
    echo -e "${YELLOW}Expected format:${NC}"
    echo "  <type>(<scope>): <subject>"
    echo ""
    echo -e "${YELLOW}Valid types:${NC}"
    echo "  $TYPES"
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo "  feat(api): add user authentication"
    echo "  fix(ui): resolve button alignment issue"
    echo "  docs(readme): update installation guide"
    echo "  chore(deps): update dependency versions"
    echo "  refactor(core): simplify error handling"
    echo ""
    echo -e "${YELLOW}Rules:${NC}"
    echo "  • Type must be one of the valid types listed above"
    echo "  • Scope is optional but recommended (lowercase, alphanumeric, hyphen, underscore)"
    echo "  • Subject must start with lowercase letter"
    echo "  • Subject should not exceed 50 characters"
    echo "  • Use imperative mood (e.g., 'add' not 'added')"
    echo "  • Do not end subject with a period"
    echo ""
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    exit 1
fi

# Extract type and scope for feedback
TYPE=$(echo "$SUBJECT" | sed -E 's/^(\w+)(\(.+\))?!?:.*/\1/')
SCOPE=$(echo "$SUBJECT" | sed -E 's/^\w+(\((.+)\))?!?:.*/\2/')
SUBJECT_TEXT=$(echo "$SUBJECT" | sed -E 's/^\w+(\(.+\))?!?: //')

echo -e "${GREEN}✓ Commit message is valid!${NC}"
echo ""
echo -e "${BLUE}Parsed commit:${NC}"
echo -e "  ${YELLOW}Type:${NC}    $TYPE"
if [ -n "$SCOPE" ] && [ "$SCOPE" != "$SUBJECT" ]; then
    echo -e "  ${YELLOW}Scope:${NC}   $SCOPE"
fi
echo -e "  ${YELLOW}Subject:${NC} $SUBJECT_TEXT"
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

exit 0
